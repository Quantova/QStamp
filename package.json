{
  "name": "@quantovainc/qstamp",
  "version": "0.6.0",
  "description": "Post quantum time stamping for records, software, financial data and AI artefacts on the Quantova network, with receipts any party can verify.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qstamp": "bin/qstamp.js"
  },
  "scripts": {
    "lint": "node scripts/lint.js && eslint .",
    "test": "node --test test/*.test.js",
    "contract": "bash scripts/build-contract.sh"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "bin/",
    "contract/",
    "scripts/build-contract.sh",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qcore": "0.11.0"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "timestamp",
    "notary",
    "provenance",
    "merkle",
    "ml-dsa",
    "fips-204",
    "audit",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QStamp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QStamp.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QStamp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "16.5.0"
  }
}
